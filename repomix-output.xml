            editForm.value.attachmentPreviewUrl = URL.createObjectURL(file);
        } else {
            editForm.value.attachmentPreviewUrl = null;
        }
    }
};

const removeEditAttachment = () => {
    editForm.value.attachment = null;
    editForm.value.attachment_name = '';
    editForm.value.attachmentPreviewUrl = null;
